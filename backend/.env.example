## Environment
ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=50

## OpenAI
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TIMEOUT_SEC=60

## Transcription
TRANSCRIPTION_ENABLED=1
TRANSCRIPTION_CACHE_DIR=backend/.cache/transcripts
TRANSCRIPTION_MAX_CALLS_PER_MIN=3

## Summarization
SUMMARIZATION_ENABLED=1
OPENAI_SUMMARIZE_MODEL=gpt-5.4-mini
SUMMARIZATION_CACHE_DIR=backend/.cache/summaries
SUMMARIZATION_MAX_CALLS_PER_MIN=10
SUMMARIZATION_PROMPT_VERSION=2026-05-07-1
SUMMARIZATION_RETRY_ON_INVALID_JSON=0
SUMMARIZATION_REWRITE_ON_LANGUAGE_MISMATCH=0

## Auth + quota (requires Mongo)
# NOTE: In production, keep AUTH_ENABLED=1.
AUTH_ENABLED=1
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_DB_NAME=echobrief
SUMMARIES_TOTAL_LIMIT_DEFAULT=5

## Dev-only endpoint (registered only when ENV=local)
OPENAI_TEST_ENABLED=0

